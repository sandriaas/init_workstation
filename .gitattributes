# Force LF for shell/config files (must run on Linux)
*.sh          text eol=lf
*.conf        text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.service     text eol=lf
*.local       text eol=lf
*.txt         text eol=lf
*.log         text eol=lf

# Allow CRLF for Windows files
*.bat         text eol=crlf
*.ps1         text eol=crlf

# Markdown and text docs
*.md          text eol=lf
