#!/bin/bash
# /etc/rc.local
# Compatibility script for systemd. Runs on WSL2 boot (and on every k3s
# restart, since rc-local.service has RemainAfterExit=yes).
#
# Steps:
#  1. Start Tailscale (workaround for WSL2 SIGTERM restart loop)
#  2. Re-apply Zeabur cluster fixes (CoreDNS forward, NATS JetStream, etc.)
#     This is also called from k3s.service.d/override.conf ExecStartPost
#     after k3s is fully up, so cluster fixes are applied twice — once
#     before k3s and once after — but the script is idempotent.

set -e

# 1. Tailscale
if [ -x /usr/local/bin/start-tailscale.sh ]; then
    /usr/local/bin/start-tailscale.sh
fi

# 2. Zeabur cluster fixes (pre-k3s phase; only the resolv.conf part runs
#    here since k3s isn't up yet)
if [ -x /opt/zeabur-fixes/apply-fixes.sh ]; then
    /opt/zeabur-fixes/apply-fixes.sh || true
fi

exit 0
